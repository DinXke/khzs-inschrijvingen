# Kopieer naar .env en vul aan. .env staat niet in git.
# Adres van de demo zoals bezoekers het zien: via de Cloudflare Worker op khzs.be/leden-demo (zie README.md).
# Lokaal testen: http://localhost:8094/leden-demo
DEMO_URL=https://khzs.be/leden-demo
# Poort op de host; de tunnel wijst naar http://<host>:8094
DEMO_POORT=8094
# 127.0.0.1 als cloudflared op dezelfde host draait, anders 0.0.0.0
DEMO_BIND=127.0.0.1
# Wachtwoord van de database (enkel binnen Docker gebruikt)
DB_WACHTWOORD=vervang-door-iets-willekeurigs
# Mailadres van het beheeraccount in wp-admin (er worden geen mails verstuurd)
BEHEER_EMAIL=beheer@example.com
# Tak die de demo volgt
DEMO_TAK=main
